# Database
MONGO_URI=your_mongodb_connection_string

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# API base URLs (Postman / frontend)
API_URL_LOCAL=http://localhost:5000
API_URL_PRODUCTION=https://healzy-adminpanel-backend.vercel.app

# Which URL is active: local | production
API_ENV=local

# Server port (local only)
PORT=5000
